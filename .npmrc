# GitHub Packages requires the org scope (@pack-devorg). package.json
# aliases those tarballs back to @pack/* so imports stay @pack/schemas,
# @pack/locality-catalog, and @pack/web-effects. CI sets NODE_AUTH_TOKEN
# from GITHUB_TOKEN (packages: read). The owner grants Pack-DevOrg/PackWebsite
# Read under each package's Manage Actions access.
@pack:registry=https://npm.pkg.github.com
@pack-devorg:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
