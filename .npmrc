# GitHub Packages publishes these under the org scope (@pack-devorg).
# package.json aliases those tarballs back to @pack/* so imports stay
# @pack/schemas, @pack/locality-catalog, and @pack/web-effects.
# CI sets NODE_AUTH_TOKEN from GITHUB_TOKEN (packages: read).
@pack:registry=https://npm.pkg.github.com
@pack-devorg:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# react-native is a peer of @react-navigation/native and friends; the site aliases react-native-web,
# so npm must not auto-install react-native (it needs React 19).
legacy-peer-deps=true
