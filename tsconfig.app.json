{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pack/ui-primitives": ["packages/ui-primitives/src/index.ts"],
      "@pack/ui-primitives/*": ["packages/ui-primitives/src/*"],
      "@pack/app/onboarding/OnboardingComponents": [
        "../PackApp/src/components/onboarding/OnboardingComponents.tsx",
        "../../PackApp/src/components/onboarding/OnboardingComponents.tsx"
      ],
      "@pack/app/icons/GoogleOutlineIcon": [
        "../PackApp/src/icons/svg/GoogleOutlineIcon.tsx",
        "../../PackApp/src/icons/svg/GoogleOutlineIcon.tsx"
      ],
      "@pack/app/icons/AppleOutlineIcon": [
        "../PackApp/src/icons/svg/AppleOutlineIcon.tsx",
        "../../PackApp/src/icons/svg/AppleOutlineIcon.tsx"
      ],
      "@pack/app/icons/MicrosoftIcon": [
        "../PackApp/src/icons/svg/MicrosoftIcon.tsx",
        "../../PackApp/src/icons/svg/MicrosoftIcon.tsx"
      ],
      "@pack/app/icons/ChevronLeftIcon": [
        "../PackApp/src/icons/svg/ChevronLeftIcon.tsx",
        "../../PackApp/src/icons/svg/ChevronLeftIcon.tsx"
      ],
      "@pack/schemas": ["../PackServer/packages/schemas/src/index.ts"],
      "@pack/schemas/*": ["../PackServer/packages/schemas/src/*"],
      "@pack/web-effects/*": ["../PackServer/packages/web-effects/vendor/*/dist"],
      "react-native": ["node_modules/react-native-web"]
    }
  },
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "packages/ui-primitives/src"
  ]
}
